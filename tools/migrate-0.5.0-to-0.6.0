#!/usr/bin/env python3
"""Re-materialize one 0.5.0 work-cycle chain under the 0.6.0 contracts."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
from typing import Any


DOCUMENT_KEYS = {"schema", "generated_unix_ms", "content_sha256", "bindings", "document"}
EVENT_KEYS = {
    "schema", "sequence", "recorded_unix_ms", "previous_event_sha256",
    "content_sha256", "event_sha256", "bindings", "event",
}


class Refusal(Exception):
    pass


def canonical_line(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()


def canonical_document(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode()


def sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def document_content(value: dict[str, Any]) -> str:
    return sha256(canonical_document({"bindings": value["bindings"], "document": value["document"]}))


def event_content(value: dict[str, Any]) -> str:
    return sha256(canonical_document({"bindings": value["bindings"], "event": value["event"]}))


def event_hash(value: dict[str, Any]) -> str:
    return sha256(canonical_line({key: item for key, item in value.items() if key != "event_sha256"}))


def load_json(path: Path, label: str) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise Refusal(f"cannot read {label} {path}: {error}") from error


def exact_keys(value: Any, keys: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise Refusal(f"{label} must contain exactly {sorted(keys)}")
    return value


def load_document(path: Path, schema: str) -> dict[str, Any]:
    value = exact_keys(load_json(path, schema), DOCUMENT_KEYS, f"{path} envelope")
    if value["schema"] != schema:
        raise Refusal(f"{path}: expected {schema}, observed {value.get('schema')!r}")
    if value["content_sha256"] != document_content(value):
        raise Refusal(f"{path}: content_sha256 mismatch")
    return value


def load_log(path: Path) -> list[dict[str, Any]]:
    try:
        raw = path.read_bytes()
    except OSError as error:
        raise Refusal(f"cannot read Run ledger {path}: {error}") from error
    if raw and not raw.endswith(b"\n"):
        raise Refusal("Run ledger must end at a complete record")
    events: list[dict[str, Any]] = []
    previous: str | None = None
    for index, line in enumerate(raw.splitlines()):
        try:
            value = exact_keys(json.loads(line), EVENT_KEYS, f"Run ledger line {index + 1}")
        except json.JSONDecodeError as error:
            raise Refusal(f"Run ledger line {index + 1}: {error}") from error
        if value["schema"] != "k4-run-event/v5" or value["sequence"] != index:
            raise Refusal(f"Run ledger line {index + 1}: wrong schema or sequence")
        if value["previous_event_sha256"] != previous:
            raise Refusal(f"Run ledger line {index + 1}: broken previous-event link")
        if value["content_sha256"] != event_content(value) or value["event_sha256"] != event_hash(value):
            raise Refusal(f"Run ledger line {index + 1}: digest mismatch")
        events.append(value)
        previous = value["event_sha256"]
    return events


def binding(path: Path, value: dict[str, Any]) -> dict[str, str]:
    raw = path.read_bytes()
    return {
        "ref": f"{value['schema']}#sha256={sha256(raw)}",
        "sha256": sha256(raw),
        "content_sha256": value["content_sha256"],
    }


def run(words: list[str], label: str) -> None:
    process = subprocess.run(words, check=False, capture_output=True, text=True)
    if process.returncode != 0:
        raise Refusal(f"{label} failed: {process.stderr.strip() or process.stdout.strip()}")


def write_semantic(directory: Path, name: str, value: Any) -> Path:
    path = directory / name
    path.write_bytes(canonical_document(value))
    return path


def require_absent_output(directory: Path) -> None:
    if not directory.parent.is_dir():
        raise Refusal(f"output parent must exist: {directory.parent}")
    if directory.exists():
        raise Refusal(f"output directory must be absent: {directory}")
    directory.mkdir()


def invoke_materialize(root: Path, skill: str, semantic: Path, output: Path, binds: list[tuple[str, Path]], run_log: Path | None = None) -> None:
    contract = root / "tools" / "contracts" / "0.8.0" / f"{skill}.cue"
    words = [str(root / "tools" / "stable-result"), "--contract", str(contract), "materialize", "--input", str(semantic), "--output", str(output)]
    for name, path in binds:
        words.extend(["--bind", f"{name}={path}"])
    if run_log is not None:
        words.extend([
            "--project-log-bind", f"run={run_log}",
            "--projection-contract", str(root / "tools" / "contracts" / "0.8.0" / "k4-run.cue"),
            "--projection-bind", "goal", "--projection-bind", "plan",
        ])
    run(words, f"materialize {skill}")


def append_run_event(root: Path, semantic: Path, log: Path, goal: Path, plan: Path, label: str) -> None:
    run([
        str(root / "tools" / "stable-result"),
        "--contract", str(root / "tools" / "contracts" / "0.8.0" / "k4-run.cue"),
        "append", "--input", str(semantic), "--log", str(log),
        "--bind", f"goal={goal}", "--bind", f"plan={plan}",
    ], label)


def migrate(args: argparse.Namespace) -> dict[str, Any]:
    root = Path(__file__).resolve().parent.parent
    observe_path = Path(args.observe)
    goal_path = Path(args.goal)
    plan_path = Path(args.plan)
    run_path = Path(args.run_log) if args.run_log else None
    finish_path = Path(args.finish) if args.finish else None
    policy_path = Path(args.policy)
    output = Path(args.output_dir)
    if finish_path is not None and run_path is None:
        raise Refusal("--finish requires --run-log")

    observe = load_document(observe_path, "k4-observe-document/v2")
    goal = load_document(goal_path, "k4-goal-document/v6")
    old_plan = load_document(plan_path, "k4-plan-document/v6")
    if goal["bindings"].get("observe") != binding(observe_path, observe):
        raise Refusal("old Goal does not bind the supplied Observe document")
    if old_plan["bindings"].get("goal") != binding(goal_path, goal):
        raise Refusal("old Plan does not bind the supplied Goal document")

    policy = exact_keys(load_json(policy_path, "migration policy"), {"on_abort", "legacy_abort_source_ref"}, "migration policy")
    on_abort = exact_keys(policy["on_abort"], {"mode", "reason"}, "migration policy on_abort")
    if on_abort["mode"] != "preserve-only" or not isinstance(on_abort["reason"], str) or not on_abort["reason"]:
        raise Refusal("0.5.0 migration requires an explicit preserve-only on_abort policy and nonempty reason")
    legacy_abort_source_ref = policy["legacy_abort_source_ref"]
    if legacy_abort_source_ref is not None and (not isinstance(legacy_abort_source_ref, str) or not legacy_abort_source_ref):
        raise Refusal("legacy_abort_source_ref must be null or a nonempty string")

    require_absent_output(output)
    new_goal_path = output / "goal.json"
    shutil.copyfile(goal_path, new_goal_path)
    new_goal = load_document(new_goal_path, "k4-goal-document/v6")

    old_operations = old_plan["document"]["operations"]
    old_index = {operation["operation_id"]: index for index, operation in enumerate(old_operations)}
    plan_operations = []
    for operation in old_operations:
        item = {key: operation[key] for key in (
            "operation_key", "tool_ref", "responsible_ref", "read_refs", "write_refs",
            "permission_refs", "resource_refs", "maximum_side_effects", "pre_checks",
            "post_checks", "idempotency", "retry_limit", "recovery",
        )}
        item["phase"] = "normal"
        item["depends_on_indices"] = [old_index[value] for value in operation["depends_on"]]
        item["satisfies"] = operation["satisfies"]
        item["controlled_by"] = operation["controlled_by"]
        item["on_result"] = {
            result: {
                "next_operation_indices": [old_index[value] for value in operation["on_result"][result]["next_operation_ids"]],
                "reason": operation["on_result"][result]["reason"],
            }
            for result in ("pass", "fail")
        }
        plan_operations.append(item)
    plan_input = {
        "difference": old_plan["document"]["difference"],
        "selection_rationale": old_plan["document"]["selection_rationale"],
        "route": old_plan["document"]["route"],
        "entry_operation_indices": [old_index[value] for value in old_plan["document"]["entry_operation_ids"]],
        "on_abort": {"mode": "preserve-only", "entry_operation_index": None, "reason": on_abort["reason"]},
        "operations": plan_operations,
        "blockers": old_plan["document"]["blockers"],
        "unknowns": old_plan["document"]["unknowns"],
    }

    with tempfile.TemporaryDirectory(prefix="k4-cycle-migration-") as temporary_name:
        temporary = Path(temporary_name)
        plan_semantic = write_semantic(temporary, "plan-input.json", plan_input)
        new_plan_path = output / "plan.json"
        invoke_materialize(root, "k4-plan", plan_semantic, new_plan_path, [("goal", new_goal_path)])
        new_plan = load_document(new_plan_path, "k4-plan-document/v7")
        operation_map = {old["operation_id"]: new["operation_id"] for old, new in zip(old_operations, new_plan["document"]["operations"], strict=True)}

        new_run_path: Path | None = None
        if run_path is not None:
            events = load_log(run_path)
            old_bindings = {"goal": binding(goal_path, goal), "plan": binding(plan_path, old_plan)}
            for envelope in events:
                if envelope["bindings"] != old_bindings:
                    raise Refusal("old Run event bindings do not match the supplied Goal and Plan")
            new_run_path = output / "run.jsonl"
            output_index = 0
            for envelope in events:
                event = dict(envelope["event"])
                if event["kind"] in {"operation-result", "emergency-patch"}:
                    event["operation_id"] = operation_map[event["operation_id"]]
                if event["kind"] == "halt":
                    old_trigger = event["trigger"]
                    old_after = event["after_operation_id"]
                    event["after_operation_id"] = operation_map[old_after] if old_after is not None else None
                    event.pop("next_operation_id", None)
                    if old_trigger != "plan-complete":
                        if legacy_abort_source_ref is None:
                            raise Refusal("legacy blocked or cancelled halt requires legacy_abort_source_ref")
                        confirmation = {
                            "kind": "abort-confirmed",
                            "after_operation_id": event["after_operation_id"],
                            "source_ref": legacy_abort_source_ref,
                            "reason": f"migrated legacy {old_trigger} termination",
                            "evidence_refs": event["evidence_refs"],
                        }
                        semantic = write_semantic(temporary, f"run-event-{output_index}.json", confirmation)
                        append_run_event(root, semantic, new_run_path, new_goal_path, new_plan_path, f"migrate Run abort confirmation {output_index}")
                        output_index += 1
                        event["trigger"] = "abort"
                        if not event["side_effect_evidence_refs"]:
                            event["side_effect_evidence_refs"] = event["evidence_refs"]
                semantic = write_semantic(temporary, f"run-event-{output_index}.json", event)
                append_run_event(root, semantic, new_run_path, new_goal_path, new_plan_path, f"migrate Run event {output_index}")
                output_index += 1

        if finish_path is not None and new_run_path is not None:
            old_finish = load_document(finish_path, "k4-finish-document/v3")
            old_run_sha256 = sha256(run_path.read_bytes())
            expected_finish_bindings = {
                "previous_account": binding(observe_path, observe),
                "goal": binding(goal_path, goal),
                "plan": binding(plan_path, old_plan),
                "run": {
                    "ref": f"k4-run-projection/v5@jsonl#sha256={old_run_sha256}",
                    "sha256": old_run_sha256,
                    "content_sha256": old_run_sha256,
                },
            }
            if old_finish["bindings"] != expected_finish_bindings:
                raise Refusal("old Finish bindings do not match the supplied opening Account, Goal, Plan, and Run ledger")
            account = old_finish["document"]["account"]
            closure = old_finish["document"]["closure"]
            finish_input = {key: account[key] for key in ("subject", "boundary", "cutoff", "source_refs", "lenses", "delta", "retired")}
            finish_input["items"] = [{key: value for key, value in item.items() if key != "item_id"} for item in account["items"]]
            finish_input["acceptance_results"] = closure["acceptance_results"]
            finish_input["terminal_control_results"] = closure["terminal_control_results"]
            finish_input["result_disposition"] = closure["result_disposition"]
            finish_input["incomplete_deliverable"] = closure["incomplete_deliverable"]
            finish_semantic = write_semantic(temporary, "finish-input.json", finish_input)
            invoke_materialize(
                root, "k4-finish", finish_semantic, output / "finish.json",
                [("previous_account", observe_path), ("goal", new_goal_path), ("plan", new_plan_path)],
                run_log=new_run_path,
            )

    artifacts = {
        "goal": {"from": goal["schema"], "to": "k4-goal-document/v6", "source_sha256": sha256(goal_path.read_bytes()), "target_sha256": sha256(new_goal_path.read_bytes())},
        "plan": {"from": old_plan["schema"], "to": "k4-plan-document/v7", "source_sha256": sha256(plan_path.read_bytes()), "target_sha256": sha256((output / "plan.json").read_bytes())},
    }
    if run_path is not None:
        artifacts["run"] = {"from": "k4-run-event/v5", "to": "k4-run-event/v6", "source_sha256": sha256(run_path.read_bytes()), "target_sha256": sha256((output / "run.jsonl").read_bytes())}
    if finish_path is not None:
        artifacts["finish"] = {"from": "k4-finish-document/v3", "to": "k4-finish-document/v4", "source_sha256": sha256(finish_path.read_bytes()), "target_sha256": sha256((output / "finish.json").read_bytes())}
    report = {
        "schema": "k4-work-cycle-migration/v1",
        "from_extension": "0.5.0",
        "to_extension": "0.6.0",
        "policy_sha256": sha256(policy_path.read_bytes()),
        "artifacts": artifacts,
        "semantic_changes": ["two-state Run termination", "Plan-owned abort response", "explicit abort confirmation"],
    }
    (output / "migration.json").write_bytes(canonical_document(report))
    return report


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Migrate one exact 0.5.0 work-cycle chain to 0.6.0 by re-materializing Plan, Run, and Finish.")
    result.add_argument("--observe", required=True, help="opening k4-observe-document/v2")
    result.add_argument("--goal", required=True, help="source k4-goal-document/v6")
    result.add_argument("--plan", required=True, help="source k4-plan-document/v6")
    result.add_argument("--run-log", help="optional source k4-run-event/v5 JSONL")
    result.add_argument("--finish", help="optional source k4-finish-document/v3; requires --run-log")
    result.add_argument("--policy", required=True, help="JSON with on_abort and legacy_abort_source_ref")
    result.add_argument("--output-dir", required=True, help="absent destination directory")
    return result


def main() -> int:
    try:
        report = migrate(parser().parse_args())
        print(json.dumps({"ok": True, **report}, ensure_ascii=False, sort_keys=True))
        return 0
    except Refusal as error:
        print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False, sort_keys=True), file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
