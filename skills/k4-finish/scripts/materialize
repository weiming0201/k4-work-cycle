#!/usr/bin/env python3
"""Materialize Finish from the exact Run ledger and its verified projection."""

from __future__ import annotations

import json
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Any


HELP = """Usage: materialize --input FILE --output FILE --run-log FILE --closure-log FILE --bind previous_account=FILE --bind goal=FILE --bind plan=FILE --bind run=FILE

Settle one halted Run ledger into the shared Account and report.

Options:
  --input FILE    JSON object with the semantic fields below
  --output FILE   absent output path whose parent already exists
  --run-log FILE  exact append-only Run ledger; its projection is derived mechanically
  --closure-log FILE  exact append-only Finish closure ledger ending in one explicit halt
  --bind previous_account=FILE  exact pre-Goal Observe Account
  --bind goal=FILE              exact frozen Goal
  --bind plan=FILE              exact executable Plan
  --bind run=FILE               exact halted Run projection derived from --run-log

Semantic input:
  cutoff and delta: {summary}
  updates[]: {previous_item_id, reason, item}; omission means empty
  additions[]: {reason, item}; omission means empty
  retirements[]: {previous_item_id, reason, evidence_refs}; omission means empty
  item: {lens, epistemic_kind, state, statement, evidence_refs, route, route_ref?}
  route_ref is required only when route is external and must otherwise be absent or null.
  goal-candidate is not valid in a closing Finish Account.
  acceptance_results[]: {id, result, actual_refs, evidence_refs, unknowns?}
  terminal_control_results[]: same fields, one per terminal control; omission is
    generated as [] only when the bound Goal has no terminal controls
  each judgment result: pass | fail; unknowns are annotations, not result states
  result_disposition: {state, statement, refs}
  incomplete_deliverable: required only for fail
  attributions[]: {stage, statement, evidence_refs, claim_limit}; omission means empty
  residual_effects[]: {statement, state, refs, responsible_ref}; omission means empty

Closure events are not part of this one-shot input. Record each authorized
action and then one terminal halt with scripts/append; this Tool validates and
projects that exact ledger. An open or absent ledger cannot settle. It carries
unmentioned predecessors forward and derives Account
continuity, source closures, lenses, ids, delta evidence, Goal contracts, and
canonical null or empty fields.

Output:
  The stable Finish envelope binds the exact Run projection, identifies both
  source ledgers, and stores the next Account plus the settlement report.

Exit status: 0 on materialization; 1 without output on refusal.
"""


def argument(arguments: list[str], name: str) -> str:
    for index, word in enumerate(arguments):
        if word == name and index + 1 < len(arguments):
            return arguments[index + 1]
        if word.startswith(f"{name}="):
            return word.split("=", 1)[1]
    raise ValueError(f"{name} FILE is required")


def bindings(arguments: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    for index, word in enumerate(arguments):
        if word == "--bind" and index + 1 < len(arguments) and "=" in arguments[index + 1]:
            name, path = arguments[index + 1].split("=", 1)
            result[name] = path
    return result


def unique(values: list[str]) -> list[str]:
    result: list[str] = []
    for value in values:
        if value not in result:
            result.append(value)
    return result


def add_error(errors: list[str], message: str) -> None:
    if message not in errors:
        errors.append(message)


def require_fields(value: Any, path: str, fields: tuple[str, ...], errors: list[str]) -> bool:
    if not isinstance(value, dict):
        add_error(errors, f"{path}: must be an object")
        return False
    for field in fields:
        if field not in value:
            add_error(errors, f"{path}.{field}: required field is missing")
    return True


def preflight_item(value: Any, path: str, errors: list[str]) -> None:
    fields = ("lens", "epistemic_kind", "state", "statement", "evidence_refs", "route")
    if not require_fields(value, path, fields, errors):
        return
    route = value.get("route")
    route_ref = value.get("route_ref")
    if route == "goal-candidate":
        add_error(errors, f"{path}.route: goal-candidate is not valid in a closing Finish Account")
    elif route == "external":
        if not isinstance(route_ref, str) or not route_ref:
            add_error(errors, f"{path}.route_ref: required as a nonempty string when route is external")
    elif route in {"none", "retain"}:
        if "route_ref" in value and route_ref is not None:
            add_error(errors, f"{path}.route_ref: must be absent or null unless route is external")


def preflight(value: Any, previous: dict, goal: dict) -> list[str]:
    errors: list[str] = []
    if not isinstance(value, dict):
        return ["input: expected one JSON object"]

    terminal_controls = [
        entry for entry in goal.get("control_contracts", [])
        if entry.get("check_timing") == "terminal"
    ]
    if "terminal_control_results" not in value and terminal_controls:
        add_error(errors, "input.terminal_control_results: required because the bound Goal has terminal controls")

    forbidden_derived = sorted(set(value) & {"items", "source_refs", "closure_actions", "closure_ledger", "run_log_ref", "run_log_sha256"})
    if forbidden_derived:
        add_error(errors, f"input: derived fields are Tool-owned: {', '.join(forbidden_derived)}")
        return errors

    collections: dict[str, list[Any]] = {}
    for name in ("updates", "additions", "retirements"):
        candidate = value.get(name, [])
        if not isinstance(candidate, list):
            add_error(errors, f"input.{name}: must be an array")
            candidate = []
        collections[name] = candidate

    previous_ids = {
        item.get("item_id") for item in previous.get("items", [])
        if isinstance(item, dict) and isinstance(item.get("item_id"), str)
    }
    update_paths: dict[str, list[str]] = {}
    retirement_paths: dict[str, list[str]] = {}

    for index, entry in enumerate(collections["updates"]):
        path = f"input.updates[{index}]"
        if not require_fields(entry, path, ("previous_item_id", "reason", "item"), errors):
            continue
        reference = entry.get("previous_item_id")
        reference_path = f"{path}.previous_item_id"
        if not isinstance(reference, str) or not reference:
            add_error(errors, f"{reference_path}: must be a nonempty item id")
        else:
            update_paths.setdefault(reference, []).append(reference_path)
            if reference not in previous_ids:
                add_error(errors, f"{reference_path}: not found in the opening Account")
        preflight_item(entry.get("item"), f"{path}.item", errors)

    for paths in update_paths.values():
        if len(paths) > 1:
            for path in paths:
                add_error(errors, f"{path}: duplicates another update predecessor")

    for index, entry in enumerate(collections["retirements"]):
        path = f"input.retirements[{index}]"
        if not require_fields(entry, path, ("previous_item_id", "reason", "evidence_refs"), errors):
            continue
        reference = entry.get("previous_item_id")
        reference_path = f"{path}.previous_item_id"
        if isinstance(reference, str) and reference:
            retirement_paths.setdefault(reference, []).append(reference_path)

    for reference in sorted(set(update_paths) & set(retirement_paths)):
        for path in update_paths[reference] + retirement_paths[reference]:
            add_error(errors, f"{path}: the same predecessor cannot be both updated and retired")

    for index, entry in enumerate(collections["additions"]):
        path = f"input.additions[{index}]"
        if not require_fields(entry, path, ("reason", "item"), errors):
            continue
        preflight_item(entry.get("item"), f"{path}.item", errors)
    return errors


def semantic_item(item: dict) -> dict:
    result = {key: item[key] for key in ("lens", "epistemic_kind", "state", "statement", "evidence_refs", "route")}
    result["route_ref"] = item.get("route_ref") if item.get("route") == "external" else None
    return result


def normalize(value: object, previous: dict, goal: dict) -> dict:
    if not isinstance(value, dict):
        raise ValueError("input: expected one JSON object")
    updates = value.pop("updates", [])
    additions = value.pop("additions", [])
    retirements = value.pop("retirements", [])
    update_by_id = {entry["previous_item_id"]: entry for entry in updates}
    retired_ids = {entry["previous_item_id"] for entry in retirements}
    items: list[dict] = []
    for prior in previous["items"]:
        if prior["item_id"] in retired_ids:
            continue
        update = update_by_id.get(prior["item_id"])
        if update is None:
            retained = semantic_item(prior)
            retained.update({
                "change": "retained",
                "previous_item_id": prior["item_id"],
                "change_reason": "Unmentioned by the closing semantic delta; prior item retained.",
            })
            items.append(retained)
        else:
            changed = semantic_item(update["item"])
            changed.update({
                "change": "changed",
                "previous_item_id": prior["item_id"],
                "change_reason": update["reason"],
            })
            items.append(changed)
    for addition in additions:
        added = semantic_item(addition["item"])
        added.update({"change": "added", "previous_item_id": None, "change_reason": addition["reason"]})
        items.append(added)
    value["items"] = items
    value["retired"] = retirements

    for item in value["items"]:
        item["route_ref"] = item.get("route_ref") if item.get("route") == "external" else None

    terminal_controls = {
        entry["control_id"]: entry
        for entry in goal["control_contracts"]
        if entry["check_timing"] == "terminal"
    }
    if not terminal_controls:
        value.setdefault("terminal_control_results", [])
    for result in value.get("acceptance_results", []):
        result.setdefault("unknowns", [])
    for result in value.get("terminal_control_results", []):
        result.setdefault("unknowns", [])
    value.setdefault("incomplete_deliverable", None)
    value.setdefault("attributions", [])
    value.setdefault("residual_effects", [])
    return value


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--help":
        print(HELP, end="")
        return 0

    script_dir = Path(__file__).resolve().parent
    skill_dir = script_dir.parent
    tool = os.environ.get("K4_STABLE_RESULT") or shutil.which("stable-result")
    if tool is None:
        for candidate in (
            skill_dir.parent.parent / "tools" / "stable-result",
            skill_dir.parent.parent / "workspace" / "tools" / "stable-result",
        ):
            if candidate.is_file() and os.access(candidate, os.X_OK):
                tool = str(candidate)
                break
    if tool is None:
        print("stable-result is not available", file=sys.stderr)
        return 1

    arguments = sys.argv[1:]
    forwarded: list[str] = []
    special: dict[str, str] = {}
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word in {"--run-log", "--closure-log"}:
            if word in special or index + 1 >= len(arguments):
                print(f"{word} requires exactly one FILE", file=sys.stderr)
                return 1
            special[word] = arguments[index + 1]
            index += 2
            continue
        if word.startswith("--run-log=") or word.startswith("--closure-log="):
            name, path = word.split("=", 1)
            if name in special or not path:
                print(f"{name} requires exactly one FILE", file=sys.stderr)
                return 1
            special[name] = path
            index += 1
            continue
        forwarded.append(word)
        index += 1

    if "--run-log" not in special or "--closure-log" not in special:
        print("--run-log FILE and --closure-log FILE are required", file=sys.stderr)
        return 1

    try:
        source_name = argument(arguments, "--input")
        bound = bindings(arguments)
        for required in ("previous_account", "goal", "plan", "run"):
            if required not in bound:
                raise ValueError(f"--bind {required}=FILE is required")
        previous = json.loads(Path(bound["previous_account"]).read_text())["document"]["account"]
        goal = json.loads(Path(bound["goal"]).read_text())["document"]
        raw = json.loads(Path(source_name).read_text())
        errors = preflight(raw, previous, goal)
        if errors:
            print(json.dumps({"ok": False, "error": "semantic input rejected", "errors": errors}, ensure_ascii=False, sort_keys=True), file=sys.stderr)
            return 1
        normalized = normalize(raw, previous, goal)
    except (KeyError, OSError, json.JSONDecodeError, ValueError) as error:
        print(json.dumps({"errors": [str(error)]}, ensure_ascii=False), file=sys.stderr)
        return 1

    run_log = Path(special["--run-log"])
    closure_log = Path(special["--closure-log"])
    if not run_log.is_file():
        print(f"run log does not exist: {run_log}", file=sys.stderr)
        return 1
    if not closure_log.is_file():
        print(f"closure log does not exist: {closure_log}", file=sys.stderr)
        return 1

    try:
        run_validation = subprocess.run(
            [str(skill_dir.parent / "k4-run" / "scripts" / "validate"),
             "--document", bound["run"], "--source-log", str(run_log),
             "--bind", f"goal={bound['goal']}", "--bind", f"plan={bound['plan']}"],
            check=False,
        )
        if run_validation.returncode != 0:
            return run_validation.returncode

        with tempfile.TemporaryDirectory(prefix="k4-finish-") as directory:
            temporary_dir = Path(directory)
            closure_projection = temporary_dir / "closure-projection.json"
            projection = subprocess.run(
                [str(tool), "--contract", str(skill_dir / "assets" / "protocol.cue"),
                 "project", "--expression", "project_closure", "--log", str(closure_log),
                 "--output", str(closure_projection),
                 "--bind", f"previous_account={bound['previous_account']}",
                 "--bind", f"goal={bound['goal']}",
                 "--bind", f"plan={bound['plan']}",
                 "--bind", f"run={bound['run']}"],
                check=False,
            )
            if projection.returncode != 0:
                return projection.returncode
            projection_value = json.loads(closure_projection.read_text())
            run_bytes = run_log.read_bytes()
            closure_bytes = closure_log.read_bytes()
            normalized["run_log_ref"] = f"k4-run-event/v8@jsonl#sha256={hashlib.sha256(run_bytes).hexdigest()}"
            normalized["run_log_sha256"] = hashlib.sha256(run_bytes).hexdigest()
            normalized["closure_ledger"] = {
                "ref": f"k4-finish-closure-event/v1@jsonl#sha256={hashlib.sha256(closure_bytes).hexdigest()}",
                "sha256": hashlib.sha256(closure_bytes).hexdigest(),
                "projection": projection_value["document"],
            }
            normalized_input = temporary_dir / "normalized.json"
            normalized_input.write_text(json.dumps(normalized, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
            normalized_forwarded: list[str] = []
            index = 0
            while index < len(forwarded):
                if forwarded[index] == "--input" and index + 1 < len(forwarded):
                    normalized_forwarded.extend(("--input", str(normalized_input)))
                    index += 2
                    continue
                if forwarded[index].startswith("--input="):
                    normalized_forwarded.append(f"--input={normalized_input}")
                else:
                    normalized_forwarded.append(forwarded[index])
                index += 1
            return subprocess.run(
                [str(tool), "--contract", str(skill_dir / "assets" / "protocol.cue"),
                 "materialize", *normalized_forwarded],
                check=False,
            ).returncode
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(json.dumps({"errors": [str(error)]}, ensure_ascii=False), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
