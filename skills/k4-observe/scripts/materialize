#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
skill_dir=$(dirname -- "$script_dir")
tool=${K4_STABLE_RESULT:-}

if [ "${1:-}" = "--help" ]; then
    printf '%s\n' \
        'Usage: materialize --input FILE --output FILE (--null-bind previous_account | --bind previous_account=FILE)' \
        '' \
        'Create one immutable Observe Account from temporary semantic JSON.' \
        '' \
        'Options:' \
        '  --input FILE    JSON object with the semantic fields below' \
        '  --output FILE   absent output path whose parent already exists' \
        '  --null-bind previous_account' \
        '                  bootstrap a new subject and boundary' \
        '  --bind previous_account=FILE' \
        '                  iterate the exact prior Observe or Finish Account' \
        '' \
        'Semantic input:' \
        '  mode: bootstrap | iterate' \
        '  subject, boundary, cutoff: nonempty strings' \
        '  source_refs: unique nonempty strings' \
        '  delta: {summary, evidence_refs}' \
        '  items[]: {change, previous_item_id, change_reason, epistemic_kind,' \
        '            state, statement, evidence_refs, route, route_ref}' \
        '  retired[]: {previous_item_id, reason, evidence_refs}' \
        '  change: retained | changed | added' \
        '  epistemic_kind: fact | source-statement | inference | preference | unknown' \
        '  state: aligned | gap | conflict | unknown' \
        '  route: none | goal-candidate | retain | external' \
        '' \
        'Iteration constraint:' \
        '  subject and boundary must exactly equal the prior Account.' \
        '  Bootstrap a new Account when either one changes.' \
        '' \
        'Output:' \
        '  The stable Observe envelope stores the full Account under document.account.' \
        '' \
        'Exit status: 0 on materialization; 1 without output on refusal.'
    exit 0
fi

if [ -z "$tool" ]; then tool=$(command -v stable-result || true); fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../tools/stable-result" ]; then
    tool="$skill_dir/../../tools/stable-result"
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../workspace/tools/stable-result" ]; then
    tool="$skill_dir/../../workspace/tools/stable-result"
fi
if [ -z "$tool" ]; then
    echo "stable-result is not available" >&2
    exit 1
fi

exec "$tool" --contract "$skill_dir/assets/protocol.cue" materialize "$@"
