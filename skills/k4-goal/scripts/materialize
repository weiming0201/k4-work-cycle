#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
skill_dir=$(dirname -- "$script_dir")
tool=${K4_STABLE_RESULT:-}

if [ "${1:-}" = "--help" ]; then
    printf '%s\n' \
        'Usage: materialize --input FILE --output FILE --bind observe=FILE' \
        '' \
        'Create one immutable Goal from temporary semantic JSON and one exact Observe Account.' \
        '' \
        'Options:' \
        '  --input FILE       JSON object with the semantic fields below' \
        '  --output FILE      absent output path whose parent already exists' \
        '  --bind observe=FILE  exact current Observe Account' \
        '' \
        'Semantic input:' \
        '  selected_candidate_id: one current Observe goal-candidate item id' \
        '  supporting_item_ids: optional unique current Observe item ids' \
        '  objective, selection_rationale, target: nonempty strings' \
        '  baseline_refs, scope: nonempty unique string arrays' \
        '  decision_basis: {expected_benefit, expected_cost, downside, reversibility,' \
        '    information_value, confidence, basis_refs}' \
        '  decision_basis.confidence: number from 0 through 1' \
        '  change_surface: {primary_facet, direct_change, open_boundaries,' \
        '    bounded_boundaries, frozen_boundaries, derivative_effects}' \
        '  boundary_feasibility: {checks, conclusion, unknowns}' \
        '  boundary_feasibility.checks must cover exactly once: subject-boundary,' \
        '    account-sufficiency, change-surface, execution-envelope,' \
        '    downside-control, terminal-observability, failure-stop' \
        '  each feasibility check: {criterion, result, statement, evidence_refs, unknowns}' \
        '    where result is pass | fail' \
        '  source_refs and observe_item_ids are derived from selected and supporting' \
        '    Observe items, cutoff, baselines, decision basis, feasibility, and judges' \
        '  non_goals: optional unique string array; omission means empty' \
        '  evidence_cutoff: {at: nonempty string, included_refs: nonempty unique string array}' \
        '  execution_envelope: {authorization_ref, authorization_scope,' \
        '    authorization_claim_limit, available_tools, permission_refs,' \
        '    read_refs, write_refs, resources, budget, maximum_side_effects}' \
        '  execution_envelope.available_tools, permission_refs, read_refs,' \
        '    write_refs, resources, maximum_side_effects:' \
        '    nonempty unique string arrays; its other fields are nonempty strings' \
        '  acceptance_points[]: {statement, required_evidence, judge, acceptance}' \
        '  acceptance: {observable, conditions, window, expected, falsifier,' \
        '    comparison_method, sampling_rule}' \
        '  acceptance_points[].required_evidence and acceptance.conditions:' \
        '    nonempty unique string arrays; their other semantic fields are strings' \
        '  control_contracts[]: optional {statement, required_evidence, judge,' \
        '    controlled_variable, allowed_domain, forbidden_drift,' \
        '    required_trace, check_method, check_timing}' \
        '  required_evidence, allowed_domain, forbidden_drift, required_trace:' \
        '    nonempty unique string arrays' \
        '  check_timing: invariant | terminal' \
        '  judge: {kind, ref, claim_limit}; kind is self | independent-agent | script | human' \
        '  judge.ref must be sourceable according to kind: Goal source, available tool,' \
        '    or authorization_ref for human' \
        '  blockers, unknowns: optional unique string arrays; omission means empty' \
        '  blockers or any failed feasibility check produce not-frozen;' \
        '    otherwise status is frozen.' \
        '  Unknowns are retained annotations; frozen requires at least one acceptance point.' \
        '' \
        'Output:' \
        '  The stable Goal is stored in the output envelope under document.' \
        '' \
        'Exit status: 0 on materialization; 1 on invalid input or unsafe write.'
    exit 0
fi

if [ -z "$tool" ]; then
    tool=$(command -v stable-result || true)
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../tools/stable-result" ]; then
    tool="$skill_dir/../../tools/stable-result"
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../workspace/tools/stable-result" ]; then
    tool="$skill_dir/../../workspace/tools/stable-result"
fi
if [ -z "$tool" ]; then
    echo "stable-result is not available" >&2
    exit 1
fi

exec "$tool" --contract "$skill_dir/assets/protocol.cue" materialize "$@"
