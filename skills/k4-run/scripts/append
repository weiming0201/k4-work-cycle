#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
skill_dir=$(dirname -- "$script_dir")
tool=${K4_STABLE_RESULT:-}

if [ "${1:-}" = "--help" ]; then
    printf '%s\n' \
        'Usage: append --input FILE --log FILE --bind goal=FILE --bind plan=FILE' \
        '' \
        'Append one immutable Run event from temporary semantic JSON.' \
        '' \
        'Options:' \
        '  --input FILE      JSON object containing exactly one event below' \
        '  --log FILE        append-only JSONL ledger; may be absent initially' \
        '  --bind goal=FILE  exact frozen Goal' \
        '  --bind plan=FILE  exact executable Plan' \
        '' \
        'Event inputs:' \
        '  operation-result: {kind, operation_id, result, eligibility_refs,' \
        '    actual_output_refs, evidence_refs, trace_refs, invariant_checks,' \
        '    findings, unknowns}' \
        '  invariant_checks[]: {control_id, result, actual_refs, trace_refs,' \
        '    comparison_refs, evidence_refs}' \
        '  findings[]: {statement, evidence_refs}' \
        '  unknowns[]: {statement, basis_refs}' \
        '  emergency-patch: {kind, operation_id, attempt: 1, application_result,' \
        '    reason, script_ref, tool_refs, read_refs, write_refs,' \
        '    maximum_side_effects, actual_side_effect_refs, trace_refs,' \
        '    findings, unknowns, verification_scope: mainline-resumption-only}' \
        '  halt: {kind, after_operation_id, next_operation_id, trigger,' \
        '    budget_evidence_refs, side_effect_evidence_refs, evidence_refs,' \
        '    resume_ref}' \
        '  result: pass | fail' \
        '  application_result: applied | not-applied' \
        '  trigger: plan-complete | blocked | cancelled' \
        '' \
        'Output:' \
        '  One generated operation-result, emergency-patch, or halt event is appended.' \
        '' \
        'Exit status: 0 after one append; 1 without append on invalid input.'
    exit 0
fi

if [ -z "$tool" ]; then
    tool=$(command -v stable-result || true)
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../tools/stable-result" ]; then
    tool="$skill_dir/../../tools/stable-result"
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../workspace/tools/stable-result" ]; then
    tool="$skill_dir/../../workspace/tools/stable-result"
fi
if [ -z "$tool" ]; then
    echo "stable-result is not available" >&2
    exit 1
fi

exec "$tool" --contract "$skill_dir/assets/protocol.cue" append "$@"
