#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
skill_dir=$(dirname -- "$script_dir")
tool=${K4_STABLE_RESULT:-}

if [ "${1:-}" = "--help" ]; then
    printf '%s\n' \
        'Usage: materialize --input FILE --output FILE --bind goal=FILE' \
        '' \
        'Create one immutable Plan DAG from temporary semantic JSON and one exact Goal.' \
        '' \
        'Options:' \
        '  --input FILE      JSON object with the semantic fields below' \
        '  --output FILE     absent output path whose parent already exists' \
        '  --bind goal=FILE  exact predecessor Goal' \
        '' \
        'Semantic input:' \
        '  difference, selection_rationale: nonempty strings' \
        '  route: {claim, supporting_refs, counter_refs}' \
        '  entry_operation_indices: one or more zero-based starting operations' \
        '  operations[]: {operation_key, depends_on_indices, satisfies, controlled_by, tool_ref,' \
        '    responsible_ref, read_refs, write_refs, permission_refs, resource_refs,' \
        '    maximum_side_effects, pre_checks, post_checks, idempotency,' \
        '    retry_limit, recovery, on_result}' \
        '  on_result: {pass, fail}' \
        '  each result edge: {next_operation_indices, reason}' \
        '  blockers, unknowns' \
        '' \
        'Dependency indices identify earlier operations; result edges identify only later ones.' \
        'An empty result successor reaches end; multiple successors form a fork.' \
        'Multiple exact dependencies form a join and must all route to that operation.' \
        'Every operation tool, permission, read/write position, resource, and effect' \
        'must be contained in the frozen Goal execution envelope.' \
        '' \
        'Output:' \
        '  The stable Plan is stored in the output envelope under document.' \
        'Exit status: 0 on materialization; 1 on invalid input or unsafe write.'
    exit 0
fi

if [ -z "$tool" ]; then
    tool=$(command -v stable-result || true)
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../tools/stable-result" ]; then
    tool="$skill_dir/../../tools/stable-result"
fi
if [ -z "$tool" ] && [ -x "$skill_dir/../../workspace/tools/stable-result" ]; then
    tool="$skill_dir/../../workspace/tools/stable-result"
fi
if [ -z "$tool" ]; then
    echo "stable-result is not available" >&2
    exit 1
fi

exec "$tool" --contract "$skill_dir/assets/protocol.cue" materialize "$@"
